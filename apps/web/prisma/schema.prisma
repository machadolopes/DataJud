generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  DRAFT
  QUOTING
  QUOTED
  REJECTED
  AWAITING_PAYMENT
  PAID
  PROCESSING
  REPORT_READY
  DELIVERED
  FAILED
  EXPIRED
  REFUNDED
}

model Author {
  id                   String          @id @default(cuid())
  email                String          @unique
  name                 String
  cpf                  String?
  bookxpressOptIn      Boolean         @default(false) @map("bookxpress_opt_in")
  bookxpressOptInAt    DateTime?       @map("bookxpress_opt_in_at")
  bookxpressOptOutAt   DateTime?       @map("bookxpress_opt_out_at")
  unsubscribeTokenHash String          @unique @map("unsubscribe_token_hash")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  orders               Order[]
  consents             ConsentRecord[]

  @@map("authors")
}

model ConsentRecord {
  id          String   @id @default(cuid())
  authorId    String   @map("author_id")
  purpose     String
  granted     Boolean
  textVersion String   @map("text_version")
  textShown   String   @map("text_shown")
  source      String
  orderId     String?  @map("order_id")
  ipHash      String?  @map("ip_hash")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")
  author      Author   @relation(fields: [authorId], references: [id])

  @@index([authorId, purpose, createdAt])
  @@map("consent_records")
}

model Order {
  id              String      @id @default(cuid())
  publicId        String      @unique @map("public_id")
  accessTokenHash String      @map("access_token_hash")
  status          OrderStatus @default(DRAFT)
  authorId        String      @map("author_id")
  author          Author      @relation(fields: [authorId], references: [id])
  customerName    String      @map("customer_name")
  customerEmail   String      @map("customer_email")
  customerCpf     String?     @map("customer_cpf")
  workTitle       String      @map("work_title")
  genre           String
  audience        String
  manuscriptKey   String      @map("manuscript_key")
  manuscriptMime  String      @map("manuscript_mime")
  manuscriptBytes Int         @map("manuscript_bytes")
  wordCount       Int?        @map("word_count")
  chapterCount    Int?        @map("chapter_count")
  priceTier       String?     @map("price_tier")
  priceCents      Int?        @map("price_cents")
  reportKey       String?     @map("report_key")
  consentTermsAt  DateTime    @map("consent_terms_at")
  consentAiAt     DateTime    @map("consent_ai_at")
  rejectionReason String?     @map("rejection_reason")
  failureReason   String?     @map("failure_reason")
  deliveredAt     DateTime?   @map("delivered_at")
  purgeAfter      DateTime?   @map("purge_after")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  payments        Payment[]
  jobs            Job[]
  events          OrderEvent[]

  @@map("orders")
}

model Payment {
  id               String    @id @default(cuid())
  orderId          String    @map("order_id")
  provider         String
  providerChargeId String    @unique @map("provider_charge_id")
  status           String
  amountCents      Int       @map("amount_cents")
  pixCopyPaste     String    @map("pix_copy_paste")
  pixQrBase64      String    @map("pix_qr_base64")
  expiresAt        DateTime  @map("expires_at")
  paidAt           DateTime? @map("paid_at")
  rawLastPayload   Json?     @map("raw_last_payload")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  order            Order     @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Job {
  id          String    @id @default(cuid())
  orderId     String    @map("order_id")
  queue       String
  status      String    @default("queued")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  runAfter    DateTime  @default(now()) @map("run_after")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by")
  stage       String?
  progress    Int       @default(0)
  lastError   String?   @map("last_error")
  llmUsage    Json?     @map("llm_usage")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  order       Order     @relation(fields: [orderId], references: [id])

  @@unique([orderId, queue])
  @@index([queue, status, runAfter])
  @@map("jobs")
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  type      String
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id])

  @@map("order_events")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  externalId  String    @map("external_id")
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  payload     Json

  @@unique([provider, externalId])
  @@map("webhook_events")
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@map("admin_audit_logs")
}
