# Geral
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://parecer:parecer@localhost:5432/parecer
ADMIN_PASSWORD=dev-admin-password-change-me
CRON_SECRET=dev-cron-secret-change-me
SESSION_SECRET=dev-session-secret-change-me-min-32-chars
UNSUBSCRIBE_TOKEN_SALT=dev-unsubscribe-salt-change-me
IP_HASH_SALT=dev-ip-hash-salt-change-me

# Storage (MinIO local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=parecer
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Pagamento
PAYMENT_PROVIDER=mock
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PIX_EXPIRATION_MINUTES=30

# E-mail
EMAIL_PROVIDER=mailpit
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
RESEND_API_KEY=
EMAIL_FROM="Parecer Literário <parecer@seudominio.com.br>"
ADMIN_EMAIL=admin@localhost

# LLM
LLM_MODE=mock
ANTHROPIC_API_KEY=
LLM_MODEL_SMALL=claude-haiku-4-5-20251001
LLM_MODEL_MEDIUM=claude-sonnet-5-5
LLM_MODEL_LARGE=claude-opus-5-5
LLM_USE_BATCH=false
LLM_MAX_CONCURRENCY=4
ANALYSIS_MODE=completo

# Limites
MAX_UPLOAD_MB=20
MIN_WORDS=5000
MAX_WORDS=200000
SENTIMENT_MODEL=

# Observabilidade
SENTRY_DSN=

# Worker
WORKER_ID=
JOB_STALE_MINUTES=60
JOB_HEARTBEAT_SECONDS=30
